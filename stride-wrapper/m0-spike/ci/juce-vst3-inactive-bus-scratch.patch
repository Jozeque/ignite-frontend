+    AudioBuffer<float>  scratchFloat;    // STRIDE PATCH
+    AudioBuffer<double> scratchDouble;   // STRIDE PATCH
+    int maxBusChannels = 0;              // STRIDE PATCH
+
     std::vector<Steinberg::Vst::AudioBusBuffers> busBuffers;
     std::vector<ChannelMapping> mappings;
 };
