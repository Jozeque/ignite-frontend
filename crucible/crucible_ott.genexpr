/* 6x OTT chain on ONE macro (smoothed). OTT knob drives density + tone. */
Param color(0);
History xlo0(0);
History xhi0(0);
History elo0(0);
History emid0(0);
History ehi0(0);
History xlo1(0);
History xhi1(0);
History elo1(0);
History emid1(0);
History ehi1(0);
History xlo2(0);
History xhi2(0);
History elo2(0);
History emid2(0);
History ehi2(0);
History xlo3(0);
History xhi3(0);
History elo3(0);
History emid3(0);
History ehi3(0);
History xlo4(0);
History xhi4(0);
History elo4(0);
History emid4(0);
History ehi4(0);
History xlo5(0);
History xhi5(0);
History elo5(0);
History emid5(0);
History ehi5(0);
History s_col(0);
sr = samplerate;
loc = 1 - exp(-2*pi*250/sr);
hic = 1 - exp(-2*pi*2500/sr);
atk = 0.01; rel = 0.0008; sc = 0.0022;
mo = s_col + sc*(color  - s_col); s_col = mo;
am = mo;
tgt = 0.10 + mo*0.14;
sig = in1;
/* OTT 0 */
xlo0 = xlo0 + loc*(sig - xlo0); blo = xlo0;
xhi0 = xhi0 + hic*(sig - xhi0); bml = xhi0;
bhi = sig - bml; bmid = bml - blo;
al = abs(blo);  elo0  = (al > elo0)  ? elo0  + atk*(al-elo0)  : elo0  + rel*(al-elo0);
am2 = abs(bmid); emid0 = (am2 > emid0) ? emid0 + atk*(am2-emid0) : emid0 + rel*(am2-emid0);
ah = abs(bhi);  ehi0  = (ah > ehi0)  ? ehi0  + atk*(ah-ehi0)  : ehi0  + rel*(ah-ehi0);
wet0 = clamp((am - 0)*1.8, 0, 1);
dep0 = 0.18 + am*0.5 + mo*0.15;
tb0 = (mo - 0.5)*1;
gl = clamp(pow((tgt+0.0001)/(elo0+0.0001), dep0), 0.2, 10);
gm = clamp(pow((tgt+0.0001)/(emid0+0.0001), dep0), 0.2, 10);
gh = clamp(pow((tgt+0.0001)/(ehi0+0.0001), dep0), 0.2, 10);
ott = blo*gl*(1 - tb0*0.6) + bmid*gm + bhi*gh*(1 + tb0*0.6);
sig = sig + (ott - sig)*wet0;
/* OTT 1 */
xlo1 = xlo1 + loc*(sig - xlo1); blo = xlo1;
xhi1 = xhi1 + hic*(sig - xhi1); bml = xhi1;
bhi = sig - bml; bmid = bml - blo;
al = abs(blo);  elo1  = (al > elo1)  ? elo1  + atk*(al-elo1)  : elo1  + rel*(al-elo1);
am2 = abs(bmid); emid1 = (am2 > emid1) ? emid1 + atk*(am2-emid1) : emid1 + rel*(am2-emid1);
ah = abs(bhi);  ehi1  = (ah > ehi1)  ? ehi1  + atk*(ah-ehi1)  : ehi1  + rel*(ah-ehi1);
wet1 = clamp((am - 0.07)*1.8, 0, 1);
dep1 = 0.18 + am*0.5 + mo*0.15;
tb1 = (mo - 0.5)*-1;
gl = clamp(pow((tgt+0.0001)/(elo1+0.0001), dep1), 0.2, 10);
gm = clamp(pow((tgt+0.0001)/(emid1+0.0001), dep1), 0.2, 10);
gh = clamp(pow((tgt+0.0001)/(ehi1+0.0001), dep1), 0.2, 10);
ott = blo*gl*(1 - tb1*0.6) + bmid*gm + bhi*gh*(1 + tb1*0.6);
sig = sig + (ott - sig)*wet1;
/* OTT 2 */
xlo2 = xlo2 + loc*(sig - xlo2); blo = xlo2;
xhi2 = xhi2 + hic*(sig - xhi2); bml = xhi2;
bhi = sig - bml; bmid = bml - blo;
al = abs(blo);  elo2  = (al > elo2)  ? elo2  + atk*(al-elo2)  : elo2  + rel*(al-elo2);
am2 = abs(bmid); emid2 = (am2 > emid2) ? emid2 + atk*(am2-emid2) : emid2 + rel*(am2-emid2);
ah = abs(bhi);  ehi2  = (ah > ehi2)  ? ehi2  + atk*(ah-ehi2)  : ehi2  + rel*(ah-ehi2);
wet2 = clamp((am - 0.14)*1.8, 0, 1);
dep2 = 0.18 + am*0.5 + mo*0.15;
tb2 = (mo - 0.5)*1;
gl = clamp(pow((tgt+0.0001)/(elo2+0.0001), dep2), 0.2, 10);
gm = clamp(pow((tgt+0.0001)/(emid2+0.0001), dep2), 0.2, 10);
gh = clamp(pow((tgt+0.0001)/(ehi2+0.0001), dep2), 0.2, 10);
ott = blo*gl*(1 - tb2*0.6) + bmid*gm + bhi*gh*(1 + tb2*0.6);
sig = sig + (ott - sig)*wet2;
/* OTT 3 */
xlo3 = xlo3 + loc*(sig - xlo3); blo = xlo3;
xhi3 = xhi3 + hic*(sig - xhi3); bml = xhi3;
bhi = sig - bml; bmid = bml - blo;
al = abs(blo);  elo3  = (al > elo3)  ? elo3  + atk*(al-elo3)  : elo3  + rel*(al-elo3);
am2 = abs(bmid); emid3 = (am2 > emid3) ? emid3 + atk*(am2-emid3) : emid3 + rel*(am2-emid3);
ah = abs(bhi);  ehi3  = (ah > ehi3)  ? ehi3  + atk*(ah-ehi3)  : ehi3  + rel*(ah-ehi3);
wet3 = clamp((am - 0.21)*1.8, 0, 1);
dep3 = 0.18 + am*0.5 + mo*0.15;
tb3 = (mo - 0.5)*-1;
gl = clamp(pow((tgt+0.0001)/(elo3+0.0001), dep3), 0.2, 10);
gm = clamp(pow((tgt+0.0001)/(emid3+0.0001), dep3), 0.2, 10);
gh = clamp(pow((tgt+0.0001)/(ehi3+0.0001), dep3), 0.2, 10);
ott = blo*gl*(1 - tb3*0.6) + bmid*gm + bhi*gh*(1 + tb3*0.6);
sig = sig + (ott - sig)*wet3;
/* OTT 4 */
xlo4 = xlo4 + loc*(sig - xlo4); blo = xlo4;
xhi4 = xhi4 + hic*(sig - xhi4); bml = xhi4;
bhi = sig - bml; bmid = bml - blo;
al = abs(blo);  elo4  = (al > elo4)  ? elo4  + atk*(al-elo4)  : elo4  + rel*(al-elo4);
am2 = abs(bmid); emid4 = (am2 > emid4) ? emid4 + atk*(am2-emid4) : emid4 + rel*(am2-emid4);
ah = abs(bhi);  ehi4  = (ah > ehi4)  ? ehi4  + atk*(ah-ehi4)  : ehi4  + rel*(ah-ehi4);
wet4 = clamp((am - 0.28)*1.8, 0, 1);
dep4 = 0.18 + am*0.5 + mo*0.15;
tb4 = (mo - 0.5)*1;
gl = clamp(pow((tgt+0.0001)/(elo4+0.0001), dep4), 0.2, 10);
gm = clamp(pow((tgt+0.0001)/(emid4+0.0001), dep4), 0.2, 10);
gh = clamp(pow((tgt+0.0001)/(ehi4+0.0001), dep4), 0.2, 10);
ott = blo*gl*(1 - tb4*0.6) + bmid*gm + bhi*gh*(1 + tb4*0.6);
sig = sig + (ott - sig)*wet4;
/* OTT 5 */
xlo5 = xlo5 + loc*(sig - xlo5); blo = xlo5;
xhi5 = xhi5 + hic*(sig - xhi5); bml = xhi5;
bhi = sig - bml; bmid = bml - blo;
al = abs(blo);  elo5  = (al > elo5)  ? elo5  + atk*(al-elo5)  : elo5  + rel*(al-elo5);
am2 = abs(bmid); emid5 = (am2 > emid5) ? emid5 + atk*(am2-emid5) : emid5 + rel*(am2-emid5);
ah = abs(bhi);  ehi5  = (ah > ehi5)  ? ehi5  + atk*(ah-ehi5)  : ehi5  + rel*(ah-ehi5);
wet5 = clamp((am - 0.35)*1.8, 0, 1);
dep5 = 0.18 + am*0.5 + mo*0.15;
tb5 = (mo - 0.5)*-1;
gl = clamp(pow((tgt+0.0001)/(elo5+0.0001), dep5), 0.2, 10);
gm = clamp(pow((tgt+0.0001)/(emid5+0.0001), dep5), 0.2, 10);
gh = clamp(pow((tgt+0.0001)/(ehi5+0.0001), dep5), 0.2, 10);
ott = blo*gl*(1 - tb5*0.6) + bmid*gm + bhi*gh*(1 + tb5*0.6);
sig = sig + (ott - sig)*wet5;
out1 = tanh(sig*0.8);
