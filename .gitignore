# Design explorations / temp files
mockup.html
mockup_landing_v2.html
tmp_forensic/

# Sensitive — contains live license keys, NEVER commit
stride-vst/LICENSE_KEYS.md

# Tutorial videos — too large for git, shipped via build scripts that
# copy them straight from stride-vst/ into the Stride/Guide/ folder in
# the release zip. Keep them local only.
stride-vst/*.mov
stride-vst/*.mp4
stride-vst/*.mov.old

# ── Large binaries — backed up outside git (files >100MB are rejected by GitHub) ──
# OuterVerse sound-pack product + shipped release builds. Kept local / on store.
/OuterVerse/
/Stride Release versions/

# Temporary SDK evaluation bundle (re-downloadable)
/tmp_sdk_eval/

# Scanner/debug output dumps (regenerated by scan scripts)
stride-vst/m4l/node/_*_out.txt

# Reelcrop working media + caches (the scripts are tracked, the renders are not)
tools/reelcrop/__pycache__/
tools/reelcrop/*.mp4
tools/reelcrop/*.png
tools/reelcrop/*.jsonl

# Firebase service-account keys (grant admin access — NEVER commit) + campaign run artifacts
**/serviceAccount*.json
**/*firebase-adminsdk*.json
firebase_cloud/scripts/sent-*.csv
firebase_cloud/scripts/optout*.txt
firebase_cloud/scripts/campaign-preview.html

